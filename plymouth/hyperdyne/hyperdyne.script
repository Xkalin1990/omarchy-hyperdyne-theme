# Omarchy Hyperdyne Plymouth Theme Script
# Integrated Private Terminal 13-231-1 boot, LUKS unlock, and shutdown/reboot screens.

Window.SetBackgroundTopColor(0.102, 0.031, 0.024);
Window.SetBackgroundBottomColor(0.102, 0.031, 0.024);

# Main unified terminal window (724x544 including 12px CRT phosphor glow margin)
term.image = Image("terminal_window.png");
term.sprite = Sprite(term.image);
term.sprite.SetOpacity(1);

# Use these to adjust the progress bar timing
global.fake_progress_limit = 0.7;      # Target percentage for fake progress (0.0 to 1.0)
global.fake_progress_duration = 15.0;  # Duration in seconds to reach limit

# State variables
global.animation_frame = 0;
global.cursor_frame = 0;
global.cursor_active = 0;
global.cursor_mode = "none";  # "unlock" or "shutdown"
global.bullet_count = 0;
global.stars_width = 0;
global.fake_progress = 0.0;
global.real_progress = 0.0;
global.fake_progress_active = 0;
global.fake_progress_start_time = 0.0;
global.password_shown = 0;
global.max_progress = 0.0;

# Window size the sprites were last laid out for
global.layout_width = 0;
global.layout_height = 0;

fun update_cursor_position() {
  if (global.cursor_mode == "unlock") {
    cursor.x = prompt.x + 144 + global.stars_width;
    if (global.stars_width > 0) {
      cursor.x += 2;
    }
    cursor.y = prompt.y + 52;
    cursor.sprite.SetPosition(cursor.x, cursor.y, 10003);
  } else if (global.cursor_mode == "shutdown") {
    cursor.x = prompt.x + 410;
    cursor.y = prompt.y + 52;
    cursor.sprite.SetPosition(cursor.x, cursor.y, 10003);
  }
}

fun refresh_callback() {
  # Re-center everything if display resolution changes (e.g. Thunderbolt monitor)
  if (Window.GetWidth() != global.layout_width || Window.GetHeight() != global.layout_height) {
    layout();
  }

  global.animation_frame++;
  global.cursor_frame++;

  # Blink terminal block cursor (~0.5s period at 50 FPS)
  if (global.cursor_active == 1) {
    if ((Math.Int(global.cursor_frame / 25) % 2) == 0) {
      cursor.sprite.SetOpacity(1);
    } else {
      cursor.sprite.SetOpacity(0);
    }
  }

  # Animate fake progress to limit over time with easing
  if (global.fake_progress_active == 1) {
    elapsed_time = global.animation_frame / 50.0;
    time_ratio = elapsed_time / global.fake_progress_duration;
    if (time_ratio > 1.0) time_ratio = 1.0;

    eased_ratio = 1 - ((1 - time_ratio) * (1 - time_ratio));
    global.fake_progress = eased_ratio * global.fake_progress_limit;
    update_progress_bar(global.fake_progress);
  }
}

Plymouth.SetRefreshFunction(refresh_callback);

#----------------------------------------- Helper Functions --------------------------------

fun update_progress_bar(progress) {
  if (progress > global.max_progress) {
    global.max_progress = progress;

    width = Math.Int(progress_bar.original_image.GetWidth() * progress);
    if (width < 1) width = 1;

    progress_bar.image = progress_bar.original_image.Scale(width, progress_bar.original_image.GetHeight());
    progress_bar.sprite.SetImage(progress_bar.image);
  }
}

fun show_progress_bar() {
  prompt_boot.sprite.SetOpacity(1);
  progress_box.sprite.SetOpacity(1);
  progress_bar.sprite.SetOpacity(1);
}

fun hide_progress_bar() {
  prompt_boot.sprite.SetOpacity(0);
  progress_box.sprite.SetOpacity(0);
  progress_bar.sprite.SetOpacity(0);
}

fun show_password_dialog() {
  prompt_unlock.sprite.SetOpacity(1);
  global.cursor_active = 1;
  global.cursor_mode = "unlock";
  global.cursor_frame = 0;
  update_cursor_position();
  cursor.sprite.SetOpacity(1);
}

fun hide_password_dialog() {
  prompt_unlock.sprite.SetOpacity(0);
  stars.sprite.SetOpacity(0);
}

fun show_shutdown_dialog() {
  prompt_shutdown.sprite.SetOpacity(1);
  global.cursor_active = 1;
  global.cursor_mode = "shutdown";
  global.cursor_frame = 0;
  update_cursor_position();
  cursor.sprite.SetOpacity(1);
}

fun hide_shutdown_dialog() {
  prompt_shutdown.sprite.SetOpacity(0);
}

fun hide_cursor() {
  global.cursor_active = 0;
  global.cursor_mode = "none";
  cursor.sprite.SetOpacity(0);
}

fun start_fake_progress() {
  global.fake_progress_active = 1;
  global.animation_frame = 0;
  global.max_progress = 0.0;
  global.fake_progress = 0.0;
  global.fake_progress_start_time = 0.0;
}

fun stop_fake_progress() {
  global.fake_progress_active = 0;
}

#----------------------------------------- Prompts & Dialogue --------------------------------

prompt_unlock.image = Image("prompt_unlock.png");
prompt_unlock.sprite = Sprite(prompt_unlock.image);
prompt_unlock.sprite.SetOpacity(0);

prompt_boot.image = Image("prompt_boot.png");
prompt_boot.sprite = Sprite(prompt_boot.image);
prompt_boot.sprite.SetOpacity(0);

prompt_shutdown.image = Image("prompt_shutdown.png");
prompt_shutdown.sprite = Sprite(prompt_shutdown.image);
prompt_shutdown.sprite.SetOpacity(0);

stars.sprite = Sprite();
stars.sprite.SetOpacity(0);

cursor.image = Image("cursor.png");
cursor.sprite = Sprite(cursor.image);
cursor.sprite.SetOpacity(0);

fun position_stars() {
  stars.sprite.SetPosition(prompt.x + 144, prompt.y + 55, 10002);
}

fun display_normal_callback() {
  hide_password_dialog();
  mode = Plymouth.GetMode();

  if (mode == "shutdown" || mode == "reboot") {
    stop_fake_progress();
    hide_progress_bar();
    show_shutdown_dialog();
  } else if (mode == "boot" || mode == "resume") {
    hide_shutdown_dialog();
    hide_cursor();
    show_progress_bar();
    if (global.password_shown == 1) {
      start_fake_progress();
    }
  } else {
    hide_shutdown_dialog();
    hide_cursor();
    hide_progress_bar();
  }
}

fun display_password_callback(prompt_text, bullets) {
  global.password_shown = 1;

  stop_fake_progress();
  hide_progress_bar();
  hide_shutdown_dialog();

  max_bullets = 24;
  bullets_to_show = bullets;
  if (bullets_to_show > max_bullets) {
    bullets_to_show = max_bullets;
  }
  global.bullet_count = bullets_to_show;

  stars_str = "";
  for (index = 0; index < bullets_to_show; index++) {
    stars_str += "*";
  }

  if (bullets_to_show > 0) {
    stars.image = Image.Text(stars_str, 1.0, 0.855, 0.349, 1, "Share Tech Mono 14");
    stars.sprite.SetImage(stars.image);
    position_stars();
    stars.sprite.SetOpacity(1);
    global.stars_width = stars.image.GetWidth();
  } else {
    stars.sprite.SetOpacity(0);
    global.stars_width = 0;
  }

  show_password_dialog();
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

#----------------------------------------- Progress Bar --------------------------------

progress_box.image = Image("progress_box.png");
progress_box.sprite = Sprite(progress_box.image);
progress_box.sprite.SetOpacity(0);

progress_bar.original_image = Image("progress_bar.png");
progress_bar.sprite = Sprite();
progress_bar.image = progress_bar.original_image.Scale(1, progress_bar.original_image.GetHeight());
progress_bar.sprite.SetOpacity(0);

fun progress_callback(duration, progress) {
  if (global.fake_progress_start_time == 0.0) {
    global.fake_progress_start_time = duration;
  }

  global.real_progress = progress;

  if (duration > global.fake_progress_start_time && progress > global.fake_progress) {
    stop_fake_progress();
    update_progress_bar(progress);
  }
}

Plymouth.SetBootProgressFunction(progress_callback);

#----------------------------------------- Layout --------------------------------

fun layout() {
  global.layout_width = Window.GetWidth();
  global.layout_height = Window.GetHeight();

  term.x = global.layout_width / 2 - term.image.GetWidth() / 2;
  term.y = global.layout_height / 2 - term.image.GetHeight() / 2;
  term.sprite.SetPosition(term.x, term.y, 10000);

  # Lower terminal prompt area (inside the 12px glow padding)
  prompt.x = term.x + 12 + 30;
  prompt.y = term.y + 12 + 404;

  prompt_unlock.sprite.SetPosition(prompt.x, prompt.y, 10001);
  prompt_boot.sprite.SetPosition(prompt.x, prompt.y, 10001);
  prompt_shutdown.sprite.SetPosition(prompt.x, prompt.y, 10001);

  position_stars();

  update_cursor_position();

  progress_box.x = prompt.x + 144;
  progress_box.y = prompt.y + 61;
  progress_box.sprite.SetPosition(progress_box.x, progress_box.y, 10001);

  progress_bar.x = progress_box.x + 2;
  progress_bar.y = progress_box.y + 2;
  progress_bar.sprite.SetPosition(progress_bar.x, progress_bar.y, 10002);
}

layout();

#----------------------------------------- Message --------------------------------

message_sprite = Sprite();
message_sprite.SetPosition(10, 10, 10005);

fun display_message_callback(text) {
  message = Image.Text(text, 0.94, 0.66, 0.31);
  message_sprite.SetImage(message);
  message_sprite.SetOpacity(1);
}

fun hide_message_callback(text) {
  message_sprite.SetOpacity(0);
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
